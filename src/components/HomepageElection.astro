---
import DonateModal from './donate-modal.astro';
import DonorRanking from './donor-ranking.astro';
import GE2026EasterEgg from './GE2026EasterEgg.astro';
---

<!-- Preserved homepage election content for the future Election Archive.
     Intentionally not mounted on the homepage after GE 2026. -->

    <DonorRanking preview />

    <img
      src="/images/ge-2026/Saonoi_GE-Poster_2026.webp"
      alt="โปสเตอร์ Saonoi BNK48 General Election 2026"
      class="ge-poster"
    />

    <GE2026EasterEgg />

    <div class="ge-video">
      <iframe
        src="https://www.youtube-nocookie.com/embed/QgBLEkjNyfs?playsinline=1"
        title="Saonoi BNK48 General Election 2026 Video"
        width="560"
        height="315"
        loading="lazy"
        allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
    </div>

      <!-- =================================================
       GE 2026
       Hidden / Expandable General Election Information
       ================================================= -->

  <section class="ge-section">

    <details class="ge-details">

      <summary>

        <span class="ge-details-thai">
          แตะเพื่อดูข้อมูล
        </span>

        <span class="ge-details-english">
          General Election 2026 ของสาวน้อย
        </span>

        <span
          class="ge-details-icon"
          aria-hidden="true"
        >
          +
        </span>

      </summary>


      <div class="ge-content">

        <!-- =============================================
             GE APPLICATION PHOTO
             ============================================== -->

        <div class="ge-photo">

          <img
            src="/images/ge-2026/Saonoi_GE2026.jpg"
            alt="สาวน้อย พิชญ์สินี อิทธิรัตนะโกมล สมัคร BNK48 & CGM48 Senbatsu General Election 2026"
          />

        </div>


        <!-- =============================================
             APPLICATION INFORMATION
             ============================================== -->

        <div class="ge-intro">

          <span class="ge-eyebrow">
            BNK48 &amp; CGM48 SENBATSU GENERAL ELECTION 2026
          </span>

          <h2>
            สาวน้อย – พิชญ์สินี อิทธิรัตนะโกมล
          </h2>

          <p class="ge-team">
            BNK48 Team NV
          </p>

        </div>


        <div class="ge-date">

          <span class="ge-label">
            สมัครเมื่อ
          </span>

          <strong>
            7 สิงหาคม 2026 เวลา 07:07 น.
          </strong>

        </div>


        <!-- =============================================
             TARGET RANK
             ============================================== -->

        <div class="ge-target">

          <span class="ge-label">
            อันดับที่ต้องการติด
          </span>

          <strong>
            #7
          </strong>

          <p>
            เลือกวันที่ 7 สิงหาคม และเวลา 07:07 น.
            เพื่อสื่อถึงอันดับ 7 ที่ต้องการ
          </p>

        </div>


        <!-- =============================================
             CENTER SONGS
             ============================================== -->

        <div class="ge-songs">

          <span class="ge-label">
            เพลงที่ผู้สมัครต้องการเป็นเซ็นเตอร์
          </span>

          <ol>

            <li>
              <strong><a href="https://www.youtube.com/watch?v=sgTrpfINzIw" target="_blank" rel="noopener noreferrer">Kimi wa Motto Dekiru</a></strong>
              <span>HKT48</span>
            </li>
                        <li>
              <strong><a href="https://www.youtube.com/watch?v=4gMAun5RyZA" target="_blank" rel="noopener noreferrer">Hayaokuri Calendar</a></strong>
              <span>HKT48</span>
            </li>

            <li>
              <strong><a href="https://www.youtube.com/watch?v=AZWWo3wVyjQ" target="_blank" rel="noopener noreferrer">Hitsuzensei</a></strong>
              <span>IZ4648</span>
            </li>

          </ol>

        </div>


        <!-- =============================================
             WHY KIMI WA MOTTO DEKIRU
        ============================================== -->

        <div class="ge-story">

          <span class="ge-label">
            เหตุผลที่เลือกเพลง
          </span>

          <p>
            สาวน้อยเคยเล่าผ่าน Instagram Story เมื่อวันที่
            8 สิงหาคม 2026 ว่าเธอรู้จักเพลง&nbsp;
            <strong>Kimi wa Motto Dekiru</strong>&nbsp;
            ตั้งแต่การเลือกหาเพลงที่พี่สา นาโกะจัง และฮิโตมิจัง
            เคยเป็นเซ็นเตอร์ และชื่นชอบเพลงนี้เป็นพิเศษ
          </p>

        </div>


        <!-- =============================================
             SOURCE
        ============================================== -->

        <div class="ge-source">

          <a
            href="https://www.facebook.com/share/p/1LDo7zmWq8/"
            target="_blank"
            rel="noopener noreferrer"
          >
            ดูโพสต์ประกาศการสมัครบน Facebook
          </a>

          <span>
            ข้อมูลเหตุผลการเลือกเพลงอ้างอิงจาก Instagram Story
            ของสาวน้อย วันที่ 8 สิงหาคม 2026
          </span>

        </div>


        <!-- =============================================
             INSTAGRAM STORY
             Hidden / Expandable
        ============================================== -->

        <details class="ge-story-details">

          <summary>

            <span>
              ดู Instagram Story ที่เกี่ยวข้อง
            </span>

            <span
              class="ge-story-icon"
              aria-hidden="true"
            >
              +
            </span>

          </summary>


          <div class="ge-story-images">

            <img
              src="/images/ge-2026/Saonoi_IGStory_20260808-01.jpg"
              alt="Instagram Story ของสาวน้อย วันที่ 8 สิงหาคม 2026 - เหตุผลที่เลือกเพลง"
            />

            <img
              src="/images/ge-2026/Saonoi_IGStory_20260808-02.jpg"
              alt="Instagram Story ของสาวน้อย วันที่ 8 สิงหาคม 2026 - เนื้อเพลงที่ชื่นชอบ"
            />

          </div>


        </details>


      </div>

    </details>

  </section>

<DonateModal />

<style>
  /* =====================================================
     GE 2026
     ===================================================== */

  .ge-poster,
  .ge-video {

    display: block;

    box-sizing: border-box;

    width: 100%;

    height: auto;

    margin-top: 18px;

    padding: 6px;

    background: #fff;

    border: 1px solid rgba(0, 0, 0, 0.06);

    border-radius: 16px;

    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);

  }


  .ge-video {

    width: 100%;

    max-width: 100%;

    margin-inline: auto;

  }


  .ge-video iframe {

    display: block;

    width: 100%;

    max-width: 100%;

    margin-inline: auto;

    height: auto;

    aspect-ratio: 16 / 9;

    border: 0;

    border-radius: 10px;

  }


  .ge-section {

    width: 100%;

    margin-top: 18px;

    text-align: center;

  }


  .ge-details {

    width: 100%;

    max-width: 620px;

    margin: 0 auto;

  }


  .ge-details summary {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 7px;

    cursor: pointer;

    list-style: none;

    user-select: none;

    color: #555555;

    transition: color 0.2s ease;

  }


  .ge-details summary::-webkit-details-marker {

    display: none;

  }


  .ge-details summary:hover {

    color: #171717;

  }


  .ge-details-thai {

    font-size: 13px;

    font-weight: 650;

  }


  .ge-details-english {

    font-size: 11px;

    color: #999999;

    font-weight: 500;

  }


  .ge-details-icon {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    width: 17px;

    height: 17px;

    border: 1px solid #d4d4d2;

    border-radius: 50%;

    font-size: 12px;

    line-height: 1;

    color: #888888;

    transition:
      transform 0.25s ease,
      background 0.2s ease;

  }


  .ge-details[open] .ge-details-icon {

    transform: rotate(45deg);

    background: #f3f3f1;

  }


  .ge-content {

    margin-top: 18px;

    padding: 20px;

    text-align: left;

    background: #ffffff;

    border: 1px solid rgba(0, 0, 0, 0.045);

    border-radius: 18px;

    box-shadow:
      0 8px 28px rgba(0, 0, 0, 0.045);

  }


  /* GE APPLICATION PHOTO */

  .ge-photo {

    width: 100%;

    overflow: hidden;

    border-radius: 14px;

    margin-bottom: 20px;

  }


  .ge-photo img {

    display: block;

    width: 100%;

    height: auto;

  }


  /* GE INTRO */

  .ge-intro {

    text-align: center;

  }


  .ge-eyebrow {

    display: block;

    margin-bottom: 7px;

    font-size: 8px;

    font-weight: 700;

    letter-spacing: 0.12em;

    color: #aaaaaa;

  }


  .ge-intro h2 {

    margin: 0;

    font-size: 18px;

    line-height: 1.35;

    font-weight: 750;

    color: #222222;

  }


  .ge-team {

    margin: 5px 0 0;

    font-size: 11px;

    color: #999999;

  }


  .ge-label {

    display: block;

    margin-bottom: 7px;

    font-size: 10px;

    font-weight: 650;

    color: #999999;

  }


  .ge-date {

    margin-top: 20px;

    padding-top: 16px;

    border-top: 1px solid #eeeeec;

    text-align: center;

  }


  .ge-date strong {

    display: block;

    font-size: 13px;

    font-weight: 600;

    color: #333333;

  }


  /* TARGET RANK */

  .ge-target {

    margin-top: 16px;

    padding: 15px;

    text-align: center;

    background: #fafaf8;

    border-radius: 13px;

  }


  .ge-target strong {

    display: block;

    font-size: 30px;

    line-height: 1;

    font-weight: 800;

    color: #222222;

  }


  .ge-target p {

    margin: 7px 0 0;

    font-size: 10px;

    line-height: 1.5;

    color: #999999;

  }


  /* CENTER SONGS */

  .ge-songs {

    margin-top: 18px;

    padding-top: 18px;

    border-top: 1px solid #eeeeec;

  }


  .ge-songs ol {

    margin: 0;

    padding-left: 20px;

  }


  .ge-songs li {

    margin-bottom: 10px;

    padding-left: 4px;

  }


  .ge-songs li:last-child {

    margin-bottom: 0;

  }


  .ge-songs li strong {

    display: block;

    font-size: 13px;

    font-weight: 650;

    color: #333333;

  }


  .ge-songs li span {

    display: block;

    margin-top: 2px;

    font-size: 10px;

    color: #999999;

  }


  /* SONG STORY */

  .ge-story {

    margin-top: 18px;

    padding-top: 18px;

    border-top: 1px solid #eeeeec;

  }


  .ge-story p {

    margin: 0;

    font-size: 11px;

    line-height: 1.7;

    color: #555555;

  }


  /* SOURCE */

  .ge-source {

    margin-top: 18px;

    padding-top: 15px;

    border-top: 1px solid #eeeeec;

    text-align: center;

  }


  .ge-source a {

    display: inline-block;

    font-size: 10px;

    font-weight: 600;

    color: #777777;

    text-decoration: none;

  }


  .ge-source a:hover {

    text-decoration: underline;

  }


  .ge-source span {

    display: block;

    margin-top: 6px;

    font-size: 9px;

    line-height: 1.5;

    color: #aaaaaa;

  }


  /* INSTAGRAM STORY */

  .ge-story-details {

    margin-top: 18px;

    padding-top: 15px;

    border-top: 1px solid #eeeeec;

  }


  .ge-story-details summary {

    display: flex;

    align-items: center;

    justify-content: space-between;

    cursor: pointer;

    list-style: none;

    font-size: 11px;

    font-weight: 600;

    color: #777777;

  }


  .ge-story-details summary::-webkit-details-marker {

    display: none;

  }


  .ge-story-icon {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    width: 17px;

    height: 17px;

    border: 1px solid #d4d4d2;

    border-radius: 50%;

    font-size: 12px;

    color: #888888;

    transition:
      transform 0.25s ease,
      background 0.2s ease;

  }


  .ge-story-details[open] .ge-story-icon {

    transform: rotate(45deg);

    background: #f3f3f1;

  }


  .ge-story-images {

    display: flex;

    flex-direction: column;

    gap: 12px;

    margin-top: 14px;

  }


  .ge-story-images img {

    display: block;

    width: 100%;

    height: auto;

    border-radius: 12px;

  }




  @media (max-width: 600px) {
    .ge-section {

      margin-top: 16px;

    }

    .ge-details-thai {

      font-size: 12px;

    }

    .ge-details-english {

      font-size: 10px;

    }

    .ge-content {

      padding: 16px;

      border-radius: 15px;

    }

    .ge-intro h2 {

      font-size: 16px;

    }

    .ge-target strong {

      font-size: 28px;

    }

    .ge-story p {

      font-size: 10px;

    }

    .ge-source a {

      font-size: 9px;

    }

    .ge-story-images img {

      border-radius: 10px;

    }
  }

  @media (max-width: 380px) {
    .ge-details-thai {

      font-size: 11px;

    }

    .ge-details-english {

      font-size: 9px;

    }
  }

</style>
