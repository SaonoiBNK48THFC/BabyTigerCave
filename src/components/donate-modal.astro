---
const accountNumber = '301-505722-8';
const accountNumberCopy = '3015057228';
const accountName = 'RAWISARA W.';
---

<div class="donate-section">
  <button
    type="button"
    class="donate-trigger"
    data-donate-open
    aria-haspopup="dialog"
    aria-controls="donate-modal"
  >
    <span class="donate-trigger-icon" aria-hidden="true">♡</span>

    <span class="donate-trigger-text">
      <strong>สนับสนุน Saonoi</strong>
      <small>Donate for GE 2026</small>
    </span>

    <span class="donate-trigger-arrow" aria-hidden="true">→</span>
  </button>
</div>


<div
  class="donate-modal"
  id="donate-modal"
  data-donate-modal
  aria-hidden="true"
>
  <div
    class="donate-backdrop"
    data-donate-close
  ></div>

  <div
    class="donate-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="donate-title"
  >
    <button
      type="button"
      class="donate-close"
      data-donate-close
      aria-label="ปิดหน้าต่าง"
    >
      ×
    </button>

    <div class="donate-header">
      <span class="donate-eyebrow">
        SUPPORT SAONOI
      </span>

      <h2 id="donate-title">
        สนับสนุน Saonoi
      </h2>

      <p>
        ร่วมสนับสนุนการเดินทางของสาวน้อย<br />
        ใน GE 2026
      </p>
    </div>


    <div class="donate-image">
      <img
        src="/images/ge-2026/BabyTigerCave_GE-Donate_2026.webp"
        alt="ช่องทางสนับสนุน Saonoi BNK48 GE 2026"
      />
    </div>


    <div class="donate-account">
      <span class="donate-label">
        ช่องทางการโอน
      </span>

      <div class="donate-bank">
        <img
          src="/images/ge-2026/SCB-logo.webp"
          alt="SCB"
          class="donate-bank-logo"
        />
      </div>

      <div class="donate-account-number">
        <span>{accountNumber}</span>

        <button
          type="button"
          class="copy-button"
          data-copy-account
          data-account={accountNumberCopy}
        >
          <span data-copy-text>Copy</span>
        </button>
      </div>

      <span class="donate-account-name">
        {accountName}
      </span>
    </div>


    <p class="donate-note">
      โปรดตรวจสอบชื่อบัญชีก่อนยืนยันการโอนทุกครั้ง
    </p>


    <div class="donate-slip">
      <p class="donate-slip-question">
        โอนเรียบร้อยแล้ว?
      </p>

      <p class="donate-slip-info">
        ส่งสลิปผ่าน LINE OpenChat ของบ้าน
      </p>
    </div>

  </div>
</div>


<script>
  const modal = document.querySelector('[data-donate-modal]');
  const openButton = document.querySelector('[data-donate-open]');
  const closeButtons = document.querySelectorAll('[data-donate-close]');
  const copyButton = document.querySelector('[data-copy-account]');
  const copyText = document.querySelector('[data-copy-text]');

  if (
    modal instanceof HTMLElement &&
    openButton instanceof HTMLButtonElement
  ) {
    const openModal = () => {
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('donate-modal-open');
    };

    const closeModal = () => {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('donate-modal-open');
    };

    openButton.addEventListener('click', openModal);

    closeButtons.forEach((button) => {
      button.addEventListener('click', closeModal);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && modal.classList.contains('is-open')) {
        closeModal();
      }
    });

    if (
      copyButton instanceof HTMLButtonElement &&
      copyText instanceof HTMLElement
    ) {
      copyButton.addEventListener('click', async () => {
        const account = copyButton.dataset.account;

        if (!account) return;

        try {
          await navigator.clipboard.writeText(account);

          copyText.textContent = 'คัดลอกแล้ว ✓';
          copyButton.classList.add('copied');

          window.setTimeout(() => {
            copyText.textContent = 'Copy';
            copyButton.classList.remove('copied');
          }, 1800);
        } catch {
          copyText.textContent = 'คัดลอกไม่สำเร็จ';

          window.setTimeout(() => {
            copyText.textContent = 'Copy';
          }, 1800);
        }
      });
    }
  }
</script>


<style>
  /* =====================================================
     DONATE SECTION
     ===================================================== */

  .donate-section {
    width: 100%;
    margin-top: 24px;
  }


  .donate-trigger {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 72px;
    padding: 12px 16px;

    border: 1px solid rgba(0, 0, 0, 0.045);
    border-radius: 16px;

    background: #ffffff;

    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.055);

    color: #333333;

    cursor: pointer;

    text-align: left;

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }


  .donate-trigger:hover {
    transform: translateY(-2px);

    box-shadow:
      0 11px 28px rgba(0, 0, 0, 0.08);
  }


  .donate-trigger:active {
    transform: translateY(0);
  }


  .donate-trigger-icon {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 44px;
    height: 44px;

    flex: 0 0 44px;

    border-radius: 13px;

    background: #fff4f7;

    color: #d96b86;

    font-size: 24px;
    line-height: 1;
  }


  .donate-trigger-text {
    display: flex;
    flex-direction: column;
    gap: 3px;

    min-width: 0;

    margin-left: 12px;
  }


  .donate-trigger-text strong {
    font-size: 13px;
    line-height: 1.35;
    font-weight: 700;

    color: #222222;
  }


  .donate-trigger-text small {
    font-size: 10px;
    line-height: 1.35;

    color: #999999;
  }


  .donate-trigger-arrow {
    flex-shrink: 0;

    margin-left: auto;
    padding-left: 14px;

    font-size: 18px;
    line-height: 1;

    color: #888888;

    transition:
      transform 0.2s ease,
      color 0.2s ease;
  }


  .donate-trigger:hover .donate-trigger-arrow {
    color: #222222;
    transform: translateX(2px);
  }



  /* =====================================================
     MODAL
     ===================================================== */

  .donate-modal {
    position: fixed;
    inset: 0;

    z-index: 1000;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 20px;

    visibility: hidden;
    opacity: 0;

    pointer-events: none;

    transition:
      opacity 0.2s ease,
      visibility 0.2s ease;
  }


  .donate-modal.is-open {
    visibility: visible;
    opacity: 1;

    pointer-events: auto;
  }


  .donate-backdrop {
    position: absolute;
    inset: 0;

    background: rgba(20, 20, 20, 0.48);

    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
  }


  .donate-dialog {
    position: relative;

    width: min(100%, 430px);
    max-height: calc(100vh - 40px);

    overflow-y: auto;

    padding: 24px;

    border-radius: 20px;

    background: #ffffff;

    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.18);

    transform: translateY(10px) scale(0.98);

    transition:
      transform 0.2s ease;
  }


  .donate-modal.is-open .donate-dialog {
    transform: translateY(0) scale(1);
  }


  .donate-close {
    position: absolute;

    top: 12px;
    right: 12px;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 32px;
    height: 32px;

    padding: 0;

    border: 0;
    border-radius: 50%;

    background: #f5f5f3;

    color: #777777;

    font-size: 22px;
    line-height: 1;
    font-weight: 300;

    cursor: pointer;

    transition:
      background 0.2s ease,
      color 0.2s ease;
  }


  .donate-close:hover {
    background: #eeeeec;
    color: #222222;
  }



  /* =====================================================
     HEADER
     ===================================================== */

  .donate-header {
    padding: 0 24px;

    text-align: center;
  }


  .donate-eyebrow {
    display: block;

    font-size: 8px;
    line-height: 1.3;

    font-weight: 700;

    letter-spacing: 0.14em;

    color: #aaaaaa;
  }


  .donate-header h2 {
    margin: 6px 0 0;

    font-size: 22px;
    line-height: 1.3;

    font-weight: 750;

    letter-spacing: -0.03em;

    color: #222222;
  }


  .donate-header p {
    margin: 7px 0 0;

    font-size: 11px;
    line-height: 1.6;

    color: #999999;
  }



  /* =====================================================
     QR / DONATE IMAGE
     ===================================================== */

  .donate-image {
    width: 100%;

    margin-top: 18px;

    overflow: hidden;

    border-radius: 14px;

    background: #fafaf9;
  }


  .donate-image img {
    display: block;

    width: 100%;
    height: auto;
  }



  /* =====================================================
     ACCOUNT
     ===================================================== */

  .donate-account {
    margin-top: 16px;

    padding: 15px;

    border-radius: 13px;

    background: #fafaf9;

    text-align: center;
  }


  .donate-label {
    display: block;

    font-size: 9px;
    line-height: 1.3;

    color: #999999;
  }


  .donate-bank {
    display: flex;
    justify-content: center;
    align-items: center;

    margin-top: 8px;
  }


  .donate-bank-logo {
    display: block;

    width: 40px;
    height: 40px;

    object-fit: cover;

    border-radius: 8px;
  }


  .donate-account-number {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 8px;

    margin-top: 5px;
  }


  .donate-account-number > span {
    font-size: 20px;
    line-height: 1.3;

    font-weight: 750;

    letter-spacing: 0.04em;

    color: #222222;
  }


  .copy-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 30px;

    padding: 5px 10px;

    border: 1px solid #ddddda;
    border-radius: 8px;

    background: #ffffff;

    color: #777777;

    font-size: 9px;
    line-height: 1.3;
    font-weight: 600;

    cursor: pointer;

    transition:
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }


  .copy-button:hover {
    border-color: #ccccca;

    background: #f3f3f1;

    color: #333333;
  }


  .copy-button.copied {
    border-color: #c9d9cf;

    background: #eef5f0;

    color: #52705b;
  }


  .donate-account-name {
    display: block;

    margin-top: 4px;

    font-size: 10px;
    line-height: 1.4;

    color: #888888;
  }


  .donate-note {
    margin: 12px 4px 0;

    font-size: 9px;
    line-height: 1.5;

    text-align: center;

    color: #aaaaaa;
  }


  .donate-slip {
    margin-top: 16px;
    padding-top: 15px;

    border-top: 1px solid #eeeeeb;

    text-align: center;
  }


  .donate-slip-question {
    margin: 0;

    font-size: 10px;
    line-height: 1.4;

    font-weight: 700;

    color: #555555;
  }


  .donate-slip-info {
    margin: 7px 0 0;

    font-size: 9px;
    line-height: 1.5;

    color: #888888;
  }



  /* =====================================================
     MOBILE
     ===================================================== */

  @media (max-width: 600px) {

    .donate-section {
      margin-top: 22px;
    }


    .donate-trigger {
      min-height: 66px;

      padding: 10px 13px;

      border-radius: 14px;
    }


    .donate-trigger-icon {
      width: 38px;
      height: 38px;

      flex-basis: 38px;

      border-radius: 11px;

      font-size: 21px;
    }


    .donate-trigger-text {
      margin-left: 11px;
    }


    .donate-trigger-text strong {
      font-size: 12px;
    }


    .donate-trigger-text small {
      font-size: 9px;
    }


    .donate-modal {
      align-items: flex-end;

      padding: 0;
    }


    .donate-dialog {
      width: 100%;

      max-height: calc(100vh - 20px);

      padding: 20px 16px 18px;

      border-radius: 20px 20px 0 0;

      transform: translateY(20px);
    }


    .donate-modal.is-open .donate-dialog {
      transform: translateY(0);
    }


    .donate-header {
      padding: 0 28px;
    }


    .donate-header h2 {
      font-size: 20px;
    }


    .donate-header p {
      font-size: 10px;
    }


    .donate-image {
      margin-top: 15px;

      border-radius: 12px;
    }


    .donate-account-number {
      gap: 7px;
    }


    .donate-account-number > span {
      font-size: 18px;
    }

  }


  /* =====================================================
     REDUCED MOTION
     ===================================================== */

  @media (prefers-reduced-motion: reduce) {

    .donate-trigger,
    .donate-trigger-arrow,
    .donate-modal,
    .donate-dialog,
    .donate-close,
    .copy-button {
      transition: none;
    }

  }

</style>