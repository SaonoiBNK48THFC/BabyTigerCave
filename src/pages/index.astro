<script is:inline>

  function playDebutVideo() {

    const container =
      document.getElementById('debut-video');

    if (!container) return;


    container.innerHTML = `
      <iframe
        src="https://www.youtube.com/embed/8OQKzAeZomE?autoplay=1&rel=0&playsinline=1"
        title="Saonoi BNK48 Debut Introduction"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        referrerpolicy="strict-origin-when-cross-origin">
      </iframe>
    `;

  }

</script>

