---
import {
  siFacebook,
  siInstagram,
  siX,
  siTiktok,
  siLine,
} from 'simple-icons';

const fanclubLinks = [
  {
    name: 'Facebook',
    handle: 'Saonoi BNK48 Thailand Fanclub',
    url: 'https://www.facebook.com/SaonoiBNK48THFC',
    icon: siFacebook,
    className: 'facebook',
  },
  {
    name: 'Instagram',
    handle: '@saonoi.bnk48thfc',
    url: 'https://www.instagram.com/saonoi.bnk48thfc/',
    icon: siInstagram,
    className: 'instagram',
  },
  {
    name: 'X',
    handle: '@SaonoiBNK48THFC',
    url: 'https://x.com/SaonoiBNK48THFC',
    icon: siX,
    className: 'x',
  },
  {
    name: 'TikTok',
    handle: '@saonoi.bnk48thfc',
    url: 'https://www.tiktok.com/@saonoi.bnk48thfc',
    icon: siTiktok,
    className: 'tiktok',
  },
  {
    name: 'LINE OpenChat',
    handle: 'Saonoi BNK48 Thailand Fanclub',
    url: 'https://line.me/ti/g2/tThqjevLTRgX5Tja8olMroWXo_EsBRQsIBhcMQ',
    icon: siLine,
    className: 'line',
  },
];

const officialLinks = [
  {
    name: 'Facebook',
    handle: '@saonoi.bnk48official',
    url: 'https://www.facebook.com/saonoi.bnk48official',
    icon: siFacebook,
    className: 'facebook',
  },
  {
    name: 'Instagram',
    handle: '@saonoi.bnk48official',
    url: 'https://www.instagram.com/saonoi.bnk48official/',
    icon: siInstagram,
    className: 'instagram',
  },
  {
    name: 'TikTok',
    handle: '@saonoi.bnk48official',
    url: 'https://www.tiktok.com/@saonoi.bnk48official',
    icon: siTiktok,
    className: 'tiktok',
  },
];
---

<!doctype html>
<html lang="th">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <meta
    name="description"
    content="Official fan hub for Saonoi BNK48 and Saonoi BNK48 Thailand Fanclub."
  />

  <meta
    name="referrer"
    content="strict-origin-when-cross-origin"
  />

  <title>
    Saonoi BNK48 | Official Fan Hub
  </title>

  <link
    rel="icon"
    href="/images/Saonoi-avatar-01.webp"
  />

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />

  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;750;800&display=swap"
    rel="stylesheet"
  />

</head>


<body>

  <!-- =====================================================
       SITE HEADER
       ===================================================== -->

  <header class="site-header">

    <a
      href="/"
      class="brand"
      aria-label="Baby Tiger Cave"
    >

      <img
        src="/images/logo_black-horizontal.png"
        alt="Baby Tiger Cave"
        class="brand-logo"
      />

    </a>


    <div class="header-right">

      <span class="header-label">
        Saonoi BNK48 Thailand Fanclub
      </span>


      <nav
        class="fanclub-social"
        aria-label="Saonoi BNK48 Thailand Fanclub social media"
      >

        {
          fanclubLinks.map((link) => (

            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.name}
              title={link.name}
              class={`fanclub-social-link ${link.className}`}
            >

              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
                focusable="false"
              >

                <path d={link.icon.path}></path>

              </svg>

            </a>

          ))
        }

      </nav>

    </div>

  </header>



  <!-- =====================================================
       MAIN PAGE
       ===================================================== -->

  <main class="page">


    <!-- ===================================================
         HERO
         =================================================== -->

    <section class="hero-section">

      <div class="hero-image-wrap">

        <img
          src="/images/Saonoi_hero-firstpage.webp"
          alt="Saonoi BNK48"
          class="hero-image"
        />


        <div class="avatar-wrap">

          <img
            src="/images/Saonoi-avatar-01.webp"
            alt="Saonoi BNK48 profile"
            class="avatar"
          />

        </div>

      </div>


      <!-- =================================================
           IDENTITY
           ================================================= -->

      <div class="identity">

        <h1>
          Saonoi BNK48
        </h1>

        <p>
          Pichsinee Itthiratanakomol
        </p>

      </div>

    </section>

        <!-- =================================================
         GE 2026
         Hidden / Expandable General Election Information
         ================================================= -->

    <section class="ge-section">

      <details class="ge-details">

        <summary>

          <span class="ge-details-thai">
            แตะเพื่อดูข้อมูลการสมัคร
          </span>

          <span class="ge-details-english">
            BNK48 &amp; CGM48 Senbatsu General Election 2026
          </span>

          <span
            class="ge-details-icon"
            aria-hidden="true"
          >
            +
          </span>

        </summary>


        <div class="ge-content">


          <!-- =============================================
               GE APPLICATION PHOTO
          ============================================== -->

          <div class="ge-photo">

            <img
              src="/images/ge-2026/Saonoi_GE2026.jpg"
              alt="สาวน้อย พิชญ์สินี อิทธิรัตนะโกมล สมัคร BNK48 & CGM48 Senbatsu General Election 2026"
            />

          </div>


          <!-- =============================================
               APPLICATION INFORMATION
          ============================================== -->

          <div class="ge-intro">

            <span class="ge-eyebrow">
              BNK48 &amp; CGM48 SENBATSU GENERAL ELECTION 2026
            </span>

            <h2>
              สาวน้อย – พิชญ์สินี อิทธิรัตนะโกมล
            </h2>

            <p class="ge-team">
              BNK48 Team NV
            </p>

          </div>


          <div class="ge-date">

            <span class="ge-label">
              สมัครเมื่อ
            </span>

            <strong>
              7 สิงหาคม 2026 เวลา 07:07 น.
            </strong>

          </div>


          <!-- =============================================
               TARGET RANK
          ============================================== -->

          <div class="ge-target">

            <span class="ge-label">
              อันดับที่ต้องการติด
            </span>

            <strong>
              #7
            </strong>

            <p>
              เลือกวันที่ 7 สิงหาคม และเวลา 07:07 น.
              เพื่อสื่อถึงอันดับ 7 ที่ต้องการ
            </p>

          </div>


          <!-- =============================================
               CENTER SONGS
          ============================================== -->

          <div class="ge-songs">

            <span class="ge-label">
              เพลงที่ผู้สมัครต้องการเป็นเซ็นเตอร์
            </span>

            <ol>

              <li>
                <strong>Kimi wa Motto Dekiru</strong>
                <span>HKT48</span>
              </li>

              <li>
                <strong>Hayaokuri Calendar</strong>
                <span>HKT48</span>
              </li>

              <li>
                <strong>Hitsuzensei</strong>
                <span>IZ4648</span>
              </li>

            </ol>

          </div>


          <!-- =============================================
               WHY KIMI WA MOTTO DEKIRU
          ============================================== -->

          <div class="ge-story">

            <span class="ge-label">
              เหตุผลที่เลือกเพลง
            </span>

            <p>
              สาวน้อยเคยเล่าผ่าน Instagram Story เมื่อวันที่
              8 สิงหาคม 2026 ว่าเธอรู้จักเพลง&nbsp
              <strong>Kimi wa Motto Dekiru</strong>&nbsp
              ตั้งแต่การเลือกหาเพลงที่พี่สา นาโกะจัง และฮิโตมิจัง
              เคยเป็นเซ็นเตอร์ และชื่นชอบเพลงนี้เป็นพิเศษ
            </p>

          </div>


          <!-- =============================================
               SOURCE
          ============================================== -->

          <div class="ge-source">

            <a
              href="https://www.facebook.com/share/p/1LDo7zmWq8/"
              target="_blank"
              rel="noopener noreferrer"
            >
              ดูโพสต์ประกาศการสมัครบน Facebook
            </a>

            <span>
              ข้อมูลเหตุผลการเลือกเพลงอ้างอิงจาก Instagram Story
              ของสาวน้อย วันที่ 8 สิงหาคม 2026
            </span>

          </div>


          <!-- =============================================
               INSTAGRAM STORY
               Hidden / Expandable
          ============================================== -->

          <details class="ge-story-details">

            <summary>
              <span>
                ดู Instagram Story ที่เกี่ยวข้อง
              </span>

              <span
                class="ge-story-icon"
                aria-hidden="true"
              >
                +
              </span>
            </summary>


            <div class="ge-story-images">

              <img
                src="/images//ge-2026/Saonoi_IGStory_20260808-01.jpg"
                alt="Instagram Story ของสาวน้อย วันที่ 8 สิงหาคม 2026 - เหตุผลที่เลือกเพลง"
              />

              <img
                src="/images//ge-2026/Saonoi_IGStory_20260808-02.jpg"
                alt="Instagram Story ของสาวน้อย วันที่ 8 สิงหาคม 2026 - เนื้อเพลงที่ชื่นชอบ"
              />

            </div>

          </details>


        </div>

      </details>

    </section>

    <!-- ===================================================
         MORE DETAILS
         Hidden / Expandable Profile
         =================================================== -->

    <section class="profile-details-section">

      <details class="profile-details">

        <summary>

          <span class="details-thai">
            ข้อมูลเพิ่มเติม
          </span>

          <span class="details-english">
            More Details
          </span>

          <span
            class="details-icon"
            aria-hidden="true"
          >
            +
          </span>

        </summary>


        <div class="details-content">


          <!-- ===============================================
               BASIC INFORMATION
               =============================================== -->

          <div class="bio-block">

            <div class="bio-heading">
              SAONOI
            </div>


            <div class="bio-name-thai">
              พิชญ์สินี อิทธรัตนโกมล
            </div>


            <div class="bio-name-english">
              Pichsinee Itthiratanakomol
            </div>


            <div class="bio-team">
              BNK48 Team NV
            </div>

          </div>



          <!-- ===============================================
               PROFILE INFORMATION
               =============================================== -->

          <div class="bio-grid">

            <div class="bio-item">

              <span class="bio-label">
                Date of birth
              </span>

              <strong>
                9 November 2005
              </strong>

            </div>


            <div class="bio-item">

              <span class="bio-label">
                Height
              </span>

              <strong>
                161 cm
              </strong>

            </div>


            <div class="bio-item">

              <span class="bio-label">
                Province
              </span>

              <strong>
                กรุงเทพมหานคร
              </strong>

            </div>


            <div class="bio-item">

              <span class="bio-label">
                Blood Group
              </span>

              <strong>
                O
              </strong>

            </div>

          </div>



          <!-- ===============================================
               LIKES / HOBBY
               =============================================== -->

          <div class="bio-text-list">

            <div class="bio-text-item">

              <span class="bio-label">
                Like
              </span>

              <p>
                โอวัลติน, แมว, ชาเขียว, ช็อคมิ้น, เมคอัพ
              </p>

            </div>


            <div class="bio-text-item">

              <span class="bio-label">
                Hobby
              </span>

              <p>
                ร้องเพลง, ดูหนังซีรีส์, เรียนภาษา, ทำขนม
              </p>

            </div>

          </div>



          <!-- ===============================================
               DEBUT INTRODUCTION
               =============================================== -->

          <section class="debut-section">

            <!-- YouTube Preview -->

            <div
              class="video-wrapper"
              id="debut-video"
            >

              <button
                class="youtube-preview"
                type="button"
                aria-label="Play Saonoi BNK48 Debut Introduction"
                onclick="playDebutVideo()"
              >

                <img
                  src="https://i.ytimg.com/vi/8OQKzAeZomE/maxresdefault.jpg"
                  alt="Saonoi BNK48 Debut Introduction"
                />


                <span
                  class="youtube-play"
                  aria-hidden="true"
                >

                  <svg
                    viewBox="0 0 68 48"
                    aria-hidden="true"
                  >

                    <path
                      d="M66.52 7.62a8.57 8.57 0 0 0-6.03-6.07C55.18 0 34 0 34 0S12.82 0 7.51 1.55a8.57 8.57 0 0 0-6.03 6.07C0 12.95 0 24 0 24s0 11.05 1.48 16.38a8.57 8.57 0 0 0 6.03 6.07C12.82 48 34 48 34 48s21.18 0 26.49-1.55a8.57 8.57 0 0 0 6.03-6.07C68 35.05 68 24 68 24s0-11.05-1.48-16.38Z"
                      fill="#FF0033"
                    />

                    <path
                      d="M45 24 27 14v20l18-10Z"
                      fill="#fff"
                    />

                  </svg>

                </span>

              </button>

            </div>

          </section>

        </div>

      </details>

    </section>



    <!-- ===================================================
         OFFICIAL CHANNELS
         =================================================== -->

    <section class="official-section">


      <div class="section-heading">

        <h2>
          SAONOI BNK48 Official Channels
        </h2>


        <p class="thai-description">
          สามารถติดตามสาวน้อย BNK48 ได้ในทุกช่องทางด้านล่างนี้
        </p>


        <p class="english-description">
          Follow Saonoi BNK48 through her official social media channels.
        </p>

      </div>



      <!-- Official Channel Cards -->

      <div class="official-links">

        {
          officialLinks.map((link) => (

            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="channel-card"
              aria-label={`${link.name} - ${link.handle}`}
            >

              <div class="channel-left">


                <div
                  class={`channel-icon ${link.className}`}
                  aria-hidden="true"
                >

                  <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    focusable="false"
                  >

                    <path d={link.icon.path}></path>

                  </svg>

                </div>


                <div class="channel-info">

                  <strong>
                    {link.name}
                  </strong>

                  <span>
                    {link.handle}
                  </span>

                </div>

              </div>


              <span
                class="channel-arrow"
                aria-hidden="true"
              >
                →
              </span>

            </a>

          ))
        }

      </div>

    </section>



    <!-- ===================================================
         FOOTER
         =================================================== -->

    <footer class="footer">

      <div class="footer-line"></div>


      <img
        src="/images/logo_black-square.png"
        alt="Baby Tiger Cave"
        class="footer-logo"
      />


      <p class="footer-title">
        Saonoi BNK48 Thailand Fanclub
      </p>


      <span class="footer-subtitle">
        Official Fan Hub
      </span>

      <span class="footer-credit">
    Designed &amp; maintained by&nbsp;
    <a
      href="https://x.com/krazyipod"
      target="_blank"
      rel="noopener noreferrer"
    >
      CrazyiPod
    </a>
  </span>

    </footer>


  </main>



  <!-- =====================================================
       YOUTUBE SCRIPT
       ===================================================== -->

  <script is:inline>

    function playDebutVideo() {

      const container =
        document.getElementById('debut-video');

      if (!container) return;


      container.innerHTML = `
        <iframe
          src="https://www.youtube.com/embed/8OQKzAeZomE?autoplay=1&rel=0&playsinline=1"
          title="Saonoi BNK48 Debut Introduction"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin">
        </iframe>
      `;

    }

  </script>



  <!-- =====================================================
       STYLES
       ===================================================== -->

  <style>

    /* =====================================================
       RESET / BASE
       ===================================================== */

    :global(*) {
      box-sizing: border-box;
    }


    :global(html) {

      margin: 0;
      padding: 0;

      background: #fafaf9;

      scroll-behavior: smooth;

    }


    :global(body) {

      margin: 0;
      padding: 0;

      min-width: 320px;

      background: #fafaf9;

      color: #171717;

      font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

      -webkit-font-smoothing: antialiased;

      text-rendering: optimizeLegibility;

    }


    :global(a) {
      color: inherit;
      text-decoration: none;
    }



    /* =====================================================
       SITE HEADER
       ===================================================== */

    .site-header {

      width: min(100% - 40px, 720px);

      margin: 0 auto;

      padding: 28px 0 24px;

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 30px;

    }


    .brand {

      display: inline-flex;

      align-items: center;

      text-decoration: none;

      flex-shrink: 0;

    }


    .brand-logo {

      width: 92px;

      height: auto;

      display: block;

    }


    .header-right {

      display: flex;

      align-items: center;

      justify-content: flex-end;

      gap: 18px;

      min-width: 0;

    }


    .header-label {

      font-size: 9px;

      line-height: 1.3;

      color: #8a8a8a;

      white-space: nowrap;

    }


    .fanclub-social {

      display: flex;

      align-items: center;

      gap: 13px;

    }


    .fanclub-social-link {

      width: 19px;

      height: 19px;

      display: inline-flex;

      align-items: center;

      justify-content: center;

      text-decoration: none;

      transition:
        transform 0.2s ease,
        opacity 0.2s ease;

    }


    .fanclub-social-link:hover {

      transform: translateY(-1px);

      opacity: 0.75;

    }


    .fanclub-social-link svg {

      width: 16px;

      height: 16px;

      display: block;

      fill: currentColor;

    }


    /* Fanclub Brand Colors */

    .fanclub-social-link.facebook {
      color: #1877f2;
    }

    .fanclub-social-link.instagram {
      color: #e1306c;
    }

    .fanclub-social-link.x {
      color: #111111;
    }

    .fanclub-social-link.tiktok {
      color: #111111;
    }

    .fanclub-social-link.line {
      color: #06c755;
    }



    /* =====================================================
       PAGE
       ===================================================== */

    .page {

      width: min(100% - 40px, 720px);

      margin: 0 auto;

      padding-bottom: 42px;

    }



    /* =====================================================
       HERO
       ===================================================== */

    .hero-section {

      width: 100%;

    }


    .hero-image-wrap {

      position: relative;

      width: 100%;

      overflow: visible;

    }


    .hero-image {

      width: 100%;

      height: auto;

      aspect-ratio: 16 / 6.5;

      object-fit: cover;

      display: block;

      border-radius: 18px;

      box-shadow:
        0 10px 30px rgba(0, 0, 0, 0.06);

    }



    /* =====================================================
       AVATAR
       ===================================================== */

    .avatar-wrap {

      position: relative;

      width: 76px;

      height: 76px;

      margin: -38px auto 0;

      padding: 4px;

      border-radius: 50%;

      background: rgba(255, 255, 255, 0.96);

      box-shadow:
        0 8px 25px rgba(0, 0, 0, 0.10);

      z-index: 2;

    }


    .avatar {

      display: block;

      width: 100%;

      height: 100%;

      border-radius: 50%;

      object-fit: cover;

    }



    /* =====================================================
       IDENTITY
       ===================================================== */

    .identity {

      text-align: center;

      margin-top: 12px;

    }


    .identity h1 {

      margin: 0;

      font-size:
        clamp(32px, 5vw, 40px);

      line-height: 1.15;

      font-weight: 750;

      letter-spacing: -0.04em;

      color: #171717;

    }


    .identity p {

      margin: 8px 0 0;

      font-size: 18px;

      line-height: 1.4;

      font-weight: 500;

      color: #777777;

    }

        /* =====================================================
       GE 2026
       General Election Information
       ===================================================== */

    .ge-section {

      width: 100%;

      margin-top: 18px;

      text-align: center;

    }


    .ge-details {

      width: 100%;

      max-width: 620px;

      margin: 0 auto;

    }


    .ge-details summary {

      display: inline-flex;

      align-items: center;

      justify-content: center;

      gap: 7px;

      cursor: pointer;

      list-style: none;

      user-select: none;

      color: #555555;

      transition:
        color 0.2s ease;

    }


    .ge-details summary::-webkit-details-marker {
      display: none;
    }


    .ge-details summary:hover {
      color: #171717;
    }


    .ge-details-thai {

      font-size: 13px;

      font-weight: 650;

    }


    .ge-details-english {

      font-size: 11px;

      color: #999999;

      font-weight: 500;

    }


    .ge-details-icon {

      display: inline-flex;

      align-items: center;

      justify-content: center;

      width: 17px;

      height: 17px;

      border: 1px solid #d4d4d2;

      border-radius: 50%;

      font-size: 12px;

      line-height: 1;

      color: #888888;

      transition:
        transform 0.25s ease,
        background 0.2s ease;

    }


    .ge-details[open] .ge-details-icon {

      transform: rotate(45deg);

      background: #f3f3f1;

    }


    .ge-content {

      margin-top: 18px;

      padding: 20px;

      text-align: left;

      background: #ffffff;

      border: 1px solid rgba(0, 0, 0, 0.045);

      border-radius: 18px;

      box-shadow:
        0 8px 28px rgba(0, 0, 0, 0.045);

    }


    /* GE APPLICATION PHOTO */

    .ge-photo {

      width: 100%;

      overflow: hidden;

      border-radius: 14px;

      margin-bottom: 20px;

    }


    .ge-photo img {

      display: block;

      width: 100%;

      height: auto;

    }


    /* GE INTRO */

    .ge-intro {

      text-align: center;

    }


    .ge-eyebrow {

      display: block;

      margin-bottom: 7px;

      font-size: 8px;

