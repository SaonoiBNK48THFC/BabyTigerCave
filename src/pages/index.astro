        officialLinks.map((link) => (

          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="channel-card"
            aria-label={`${link.name} - ${link.handle}`}
          >

            <div class="channel-left">

              <div
                class={`channel-icon ${link.className}`}
                aria-hidden="true"
              >

                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  focusable="false"
                >

